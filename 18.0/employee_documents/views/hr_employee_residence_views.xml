<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <!-- List View -->
        <record id="view_hr_employee_residence_list" model="ir.ui.view">
            <field name="name">hr.employee.residence.list</field>
            <field name="model">hr.employee.residence</field>
            <field name="arch" type="xml">
                <list decoration-danger="state == 'expired'"
                      decoration-warning="state == 'expiring_soon'"
                      decoration-success="state == 'valid'">
                    <field name="employee_id"/>
                    <field name="residence_type"/>
                    <field name="iqama_number"/>
                    <field name="issue_date"/>
                    <field name="expiry_date"/>
                    <field name="state" widget="badge"
                        decoration-success="state == 'valid'"
                        decoration-warning="state == 'expiring_soon'"
                        decoration-danger="state == 'expired'"/>
                </list>
            </field>
        </record>

        <!-- Form View -->
        <record id="view_hr_employee_residence_form" model="ir.ui.view">
            <field name="name">hr.employee.residence.form</field>
            <field name="model">hr.employee.residence</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_renew"
                                type="object"
                                string="Renew Document"
                                class="btn-primary"
                                invisible="state not in ['expired', 'expiring_soon']"/>
                    </header>
                   <sheet>
                        <field name="state" invisible="1"/>
                        <group>
                            <group>
                                <field name="employee_id" readonly="state == 'expired'"/>
                                <field name="residence_type" readonly="state == 'expired'"/>
                                <field name="iqama_number" required="residence_type == 'iqama'" readonly="state == 'expired'"/>
                                <field name="attachment_ids" widget="many2many_binary" readonly="state == 'expired'"/>
                            </group>
                            <group>
                                <field name="issue_date" readonly="state == 'expired'"/>
                                <field name="expiry_date" readonly="state == 'expired'"/>
                                <field name="remaining_days"
                                    decoration-danger="remaining_days &lt; 0"
                                    decoration-warning="remaining_days &lt;= 30 and remaining_days &gt;= 0"
                                    decoration-success="remaining_days &gt; 30"/>
                                <field name="state" widget="badge"
                                    decoration-success="state == 'valid'"
                                    decoration-warning="state == 'expiring_soon'"
                                    decoration-danger="state == 'expired'"/>
                                <field name="renewal_date"
                                    readonly="1"
                                    invisible="state != 'renewed'"/>
                                <field name="is_renewed" invisible="1"/>
                            </group>
                        </group>
                        
                        <field name="notes" placeholder="Notes..." readonly="state == 'expired'"/>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- Search View -->
        <record id="view_hr_employee_residence_search" model="ir.ui.view">
            <field name="name">hr.employee.residence.search</field>
            <field name="model">hr.employee.residence</field>
            <field name="arch" type="xml">
                <search>
                    <field name="employee_id"/>
                    <field name="residence_type"/>
                    <field name="iqama_number"/>
                    <filter string="Expired" name="expired" domain="[('state','=','expired')]"/>
                    <filter string="Expiring Soon" name="expiring_soon" domain="[('state','=','expiring_soon')]"/>
                    <filter string="Valid" name="valid" domain="[('state','=','valid')]"/>
                    <group expand="0" string="Group By">
                        <filter string="Employee" name="group_employee" context="{'group_by': 'employee_id'}"/>
                        <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                        <filter string="Type" name="group_type" context="{'group_by': 'residence_type'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Action -->
        <record id="action_hr_employee_residence" model="ir.actions.act_window">
            <field name="name">Employee Documents</field>
            <field name="res_model">hr.employee.residence</field>
            <field name="view_mode">list,form</field>
            <field name="context">{'search_default_expired': 1}</field>
        </record>

        <!-- Inherit hr.employee form -->
        <record id="view_hr_employee_form_residence_tab" model="ir.ui.view">
            <field name="name">hr.employee.form.residence.tab</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_form"/>
            <field name="arch" type="xml">
                <notebook position="inside">
                    <page string="Employee Documents" name="residence_permits">
                        
                        <field name="residence_ids">
                            <list readonly="1"
                                  decoration-danger="state == 'expired'"
                                  decoration-warning="state == 'expiring_soon'">
                                <field name="residence_type"/>
                                <field name="iqama_number"/>
                                <field name="issue_date"/>
                                <field name="expiry_date"/>
                                <field name="state" widget="badge"
                                    decoration-success="state == 'valid'"
                                    decoration-warning="state == 'expiring_soon'"
                                    decoration-danger="state == 'expired'"/>
                                <field name="attachment_ids" widget="many2many_binary" string="Attachments"/>
                                <field name="notes"/>
                            </list>
                        </field>
                    </page>
                </notebook>
            </field>
        </record>

        <!-- Menu -->
        <menuitem
            id="menu_hr_residence_permits"
            name="Employee Documents"
            parent="hr.menu_hr_root"
            action="action_hr_employee_residence"
            sequence="25"/>

    </data>
</odoo>
