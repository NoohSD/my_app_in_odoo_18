<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Residence Permit Expiring Soon -->
    <record id="email_template_residence_expiring_soon" model="mail.template">
        <field name="name">Residence Permit - Expiring Soon</field>
        <field name="model_id" ref="model_hr_employee_residence"/>
        <field name="subject">⚠️ تنبيه: إقامة الموظف {{ object.employee_id.name }} ستنتهي قريباً</field>
        <field name="email_to">{{ object.employee_id.work_email }}</field>
        <field name="lang">{{ object.employee_id.lang or 'ar_001' }}</field>
        <field name="auto_delete" eval="True"/>

        <field name="body_html" type="html">
            <div style="font-family: Arial, sans-serif; direction: rtl; text-align: right;">
                <h2 style="color: #f0ad4e;">
                    ⚠️ تنبيه انتهاء الإقامة قريباً
                </h2>

                <p>
                    عزيزي /
                    <strong>
                        <t t-out="object.employee_id.name"/>
                    </strong>
                    ،
                </p>

                <p>
                    نود إعلامكم بأن إقامتكم ستنتهي خلال 30 يوماً أو أقل.
                </p>

                <table style="border-collapse: collapse; width:100%;">
                    <tr style="background:#fff3cd;">
                        <td style="padding:8px;border:1px solid #ddd;">
                            <strong>نوع الوثيقة</strong>
                        </td>
                        <td style="padding:8px;border:1px solid #ddd;">
                            <t t-out="object.residence_type"/>
                        </td>
                    </tr>

                    <tr>
                        <td style="padding:8px;border:1px solid #ddd;">
                            <strong>رقم الإقامة</strong>
                        </td>
                        <td style="padding:8px;border:1px solid #ddd;">
                            <t t-out="object.iqama_number"/>
                        </td>
                    </tr>

                    <tr style="background:#fff3cd;">
                        <td style="padding:8px;border:1px solid #ddd;">
                            <strong>تاريخ الانتهاء</strong>
                        </td>
                        <td style="padding:8px;border:1px solid #ddd;">
                            <t t-out="object.expiry_date"/>
                        </td>
                    </tr>
                </table>

                <p style="color:#856404;margin-top:16px;">
                    يرجى المبادرة بتجديد الإقامة في أقرب وقت.
                </p>
            </div>
        </field>
    </record>

    <!-- Residence Permit Expired -->
    <record id="email_template_residence_expired" model="mail.template">
        <field name="name">Residence Permit - Expired</field>
        <field name="model_id" ref="model_hr_employee_residence"/>
        <field name="subject">🔴 تنبيه: انتهت إقامة الموظف {{ object.employee_id.name }}</field>
        <field name="email_to">{{ object.employee_id.work_email }}</field>
        <field name="lang">{{ object.employee_id.lang or 'ar_001' }}</field>
        <field name="auto_delete" eval="True"/>

        <field name="body_html" type="html">
            <div style="font-family: Arial, sans-serif; direction: rtl; text-align: right;">
                <h2 style="color:#dc3545;">
                    🔴 انتهاء صلاحية الإقامة
                </h2>

                <p>
                    عزيزي /
                    <strong>
                        <t t-out="object.employee_id.name"/>
                    </strong>
                    ،
                </p>

                <p>
                    نود إعلامكم بأن إقامتكم قد
                    <strong style="color:red;">انتهت</strong>
                    ويجب تجديدها فوراً.
                </p>

                <table style="border-collapse: collapse; width:100%;">
                    <tr style="background:#f8d7da;">
                        <td style="padding:8px;border:1px solid #ddd;">
                            <strong>نوع الوثيقة</strong>
                        </td>
                        <td style="padding:8px;border:1px solid #ddd;">
                            <t t-out="object.residence_type"/>
                        </td>
                    </tr>

                    <tr>
                        <td style="padding:8px;border:1px solid #ddd;">
                            <strong>رقم الإقامة</strong>
                        </td>
                        <td style="padding:8px;border:1px solid #ddd;">
                            <t t-out="object.iqama_number"/>
                        </td>
                    </tr>

                    <tr style="background:#f8d7da;">
                        <td style="padding:8px;border:1px solid #ddd;">
                            <strong>تاريخ الانتهاء</strong>
                        </td>
                        <td style="padding:8px;border:1px solid #ddd;">
                            <t t-out="object.expiry_date"/>
                        </td>
                    </tr>
                </table>

                <p style="color:#721c24;margin-top:16px;">
                    يرجى مراجعة الجهات المختصة لتجديد الإقامة فوراً.
                </p>
            </div>
        </field>
    </record>

</odoo>